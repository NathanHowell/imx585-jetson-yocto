index b26e8f5..485e3aa 100644
--- a/layers/meta-tegrademo/recipes-kernel/imx585/imx585-v4l2-driver.bb
+++ b/layers/meta-tegrademo/recipes-kernel/imx585/imx585-v4l2-driver.bb
