+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Tegra NVCSI Driver
+ *
+ * Copyright (c) 2016-2022, NVIDIA CORPORATION.  All rights reserved.
+ */
+
+#ifndef __UAPI_LINUX_NVHOST_NVCSI_IOCTL_H
