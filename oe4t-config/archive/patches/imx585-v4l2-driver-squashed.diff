+/* Describes parameter to an ACPI function */
+union ACPI_ARGUMENT {
+	__u32 type;
+
+	struct {
+		__u32 type;
+		__u32 value;
+	} integer;
+
+	struct {
+		__u32 type;
+		__u32 length; /* Number of bytes */
+		__u32 offset; /* Offset in in_buffer or out_buffer */
+	} buffer;
+
+	struct {
+		__u32 type;
+		__u64 handle;
+	} method;
+};
